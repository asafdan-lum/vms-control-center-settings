{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/video/**",
              "ui_kits/lumana-cloud/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Satoshi|Satoshi Variable|lumix-icons))/i]",
        "message": "Font not provided by the design system. Available: Satoshi, Satoshi Variable, lumix-icons."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|title|children|closable|onClose|style|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: type, title, children, closable, onClose, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:info|success|warning|error)$/]",
        "message": "<Alert> type must be one of 'info' | 'success' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|image|size|fontSize|color|external|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, image, size, fontSize, color, external, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|success|warning|alert|info)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'success' | 'warning' | 'alert' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|children|type|size|iconClass|disabled|loading|rounded|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: text, children, type, size, iconClass, disabled, loading, rounded, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CameraCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|snapshotUrl|square|status|showActions|width|height|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CameraCard> doesn't accept that prop. Declared props: name, snapshotUrl, square, status, showActions, width, height, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CameraCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:online|offline|unhealthy)$/]",
        "message": "<CameraCard> status must be one of 'online' | 'offline' | 'unhealthy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CameraControls'] > JSXAttribute > JSXIdentifier[name!=/^(?:controls|vertical|onAction|style|key|ref|className|style|children)$/]",
        "message": "<CameraControls> doesn't accept that prop. Declared props: controls, vertical, onAction, style."
